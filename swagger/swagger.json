  "definitions": {
    "User": {
      "type": "object",
      "properties": {
        "firstName": {
          "type": "string",
          "example": "John"
        },
        "lastName": {
          "type": "string",
          "example": "Doe"
        },
        "email": {
          "type": "string",
          "example": "john@example.com"
        },
        "password": {
          "type": "string",
          "example": "Password123"
        }
      }
    },
    "Exercise": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "Bench Press"
        },
        "description": {
          "type": "string",
          "example": "Chest exercise using barbell"
        },
        "category": {
          "type": "string",
          "example": "strength"
        },
        "muscleGroups": {
          "type": "array",
          "example": [
            "chest",
            "triceps",
            "shoulders"
          ],
          "items": {
            "type": "string"
          }
        },
        "equipment": {
          "type": "array",
          "example": [
            "barbell",
            "bench"
          ],
          "items": {
            "type": "string"
          }
        },
        "difficulty": {
          "type": "string",
          "example": "intermediate"
        },
        "instructions": {
          "type": "array",
          "example": [
            "Lie on bench",
            "Lower bar to chest",
            "Press up"
          ],
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Workout": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "Chest Day"
        },
        "type": {
          "type": "string",
          "example": "strength"
        },
        "date": {
          "type": "string",
          "example": "2026-02-11T10:00:00Z"
        },
        "exercises": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "exerciseId": {
                "type": "string",
                "example": "507f1f77bcf86cd799439011"
              },
              "exerciseName": {
                "type": "string",
                "example": "Bench Press"
              },
              "sets": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "setNumber": {
                      "type": "number",
                      "example": 1
                    },
                    "reps": {
                      "type": "number",
                      "example": 10
                    },
                    "weightKg": {
                      "type": "number",
                      "example": 60
                    },
                    "completed": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                }
              }
            }
          }
        },
        "totalDurationMinutes": {
          "type": "number",
          "example": 45
        },
        "caloriesBurned": {
          "type": "number",
          "example": 250
        },
        "rating": {
          "type": "number",
          "example": 5
        }
      }
    },
    "Goal": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "example": "Lose 10kg"
        },
        "description": {
          "type": "string",
          "example": "Weight loss goal"
        },
        "type": {
          "type": "string",
          "example": "weight-loss"
        },
        "targetMetric": {
          "type": "object",
          "properties": {
            "metricType": {
              "type": "string",
              "example": "weight"
            },
            "currentValue": {
              "type": "number",
              "example": 90
            },
            "targetValue": {
              "type": "number",
              "example": 80
            },
            "unit": {
              "type": "string",
              "example": "kg"
            }
          }
        },
        "targetDate": {
          "type": "string",
          "example": "2026-05-11T00:00:00Z"
        }
      }
    }
  }
